{
  "name": "inline-grammar",
  "description": "Inline grammar and tone assistance using the user's chosen AI provider.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
